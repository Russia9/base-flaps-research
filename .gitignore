# MacOS files
**/.DS_Store

# Cases: track only the dictionaries (0/, system/, constant/*Properties,
# case.foam) so every experiment case is reproducible from git history.
# Meshes, processor*/, time directories, logs and postProcessing/ stay local.
openfoam/*
!openfoam/*/
openfoam/*/*
!openfoam/*/0/
!openfoam/*/system/
!openfoam/*/constant/
!openfoam/*/case.foam
openfoam/*/constant/*
!openfoam/*/constant/*Properties

__pycache__/
