FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      freestreamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Editable per case ---------------------------------------------------------
pInf        9892.8;        // Pa; MDAC Ma 3.0 static (Pt 41.5 psia, Table 3, PDF p.46) x 101.6/80 for our D
TInf        102.51;        // K; MDAC Ma 3.0: Tt 57.0 F
UInfMag     608.84864;           // m/s   (Mach 1.5 ≈ 510, M2 ≈ 680, M2.5 ≈ 850)
UInf        (608.84864 0 0);     // x-component must equal UInfMag
RGas        287.0;         // J/(kg·K) dry air
I           0.005;         // freestream turbulence intensity (0.5%), held over sweep
muRatio     1;           // eddy-viscosity ratio mu_t/mu, held over sweep

// Derived (do not edit) -----------------------------------------------------
rhoInf      #eval{ $pInf / ($RGas * $TInf) };
qInf        #eval{ 0.5 * $rhoInf * $UInfMag * $UInfMag };
// kInf, omegaInf are recomputed per case by scripts/create_case.py from
// (I, muRatio, UInfMag, TInf) so the freestream turbulence scales with Mach.
kInf        13.901125;         // 1.5*(I*UInfMag)^2
omegaInf    657673.33;         // kInf / (muRatio * nuInf),  nuInf = muInf/rhoInf


